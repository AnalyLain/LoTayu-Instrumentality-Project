{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9875","text":"\u7f57\u5927\u4f51\u8865\u5b8c\u8ba1\u5212 \u00b7 \u8d44\u6e90\u7ad9 \u7279\u5f02\u4eba\u58eb Wiki <p>     \u7cfb\u7edf\u5316\u6536\u5f55\u3001\u62c6\u89e3\u3001\u5206\u6790\u7f57\u5927\u4f51\u7684\u97f3\u4e50\u4f5c\u54c1\uff0c\u5c24\u5176\u662f\u4e24\u5cb8\u4e09\u5730\u4e0d\u540c\u65f6\u4ee3\u3001\u4e0d\u540c\u7248\u672c\u7684\u300c\u7279\u5f02\u6b4c\u66f2\u300d\uff0c\u5e76\u9644\u4e0a MV\u3001MIDI \u7b49\u8d44\u6e90\u3002   </p> \u5f00\u59cb\u4e86\u89e3 \u8d44\u6e90\u4e0b\u8f7d 01 \u9879\u76ee\u4ecb\u7ecd \u4e86\u89e3\u8fd9\u4e2a\u9879\u76ee\u662f\u4ec0\u4e48\u3001\u4e3a\u4ec0\u4e48\u505a\uff0c\u4ee5\u53ca\u6574\u4f53\u7684\u5185\u5bb9\u67b6\u6784\u3002 02 \u66f2\u76ee\u767e\u79d1 \u6309\u5e74\u4ee3\u3001\u4e13\u8f91\u3001\u9898\u6750\u68b3\u7406\u7f57\u5927\u4f51\u7684\u66f2\u76ee\u7d22\u5f15\u3002 03 \u8001\u7f57\u5f80\u4e8b \u5173\u4e8e\u7f57\u5927\u4f51\u7684\u8f76\u4e8b\u3001\u6545\u4e8b\u4e0e\u65f6\u4ee3\u80cc\u666f\u3002 04 \u8d44\u6e90\u4e0b\u8f7d MV\u3001MIDI\u3001\u4e50\u8c31\u3001\u4f34\u594f\u7b49\u8d44\u6e90\u7684\u5f52\u6863\u4e0e\u4e0b\u8f7d\u5165\u53e3\u3002 05 \u9e23\u8c22 \u611f\u8c22\u4e3a\u672c\u7ad9\u63d0\u4f9b\u8d44\u6e90\u3001\u8003\u636e\u4e0e\u5e2e\u52a9\u7684\u670b\u53cb\u4eec\u3002"},{"location":"download/","title":"\u8d44\u6e90\u4e0b\u8f7d","text":"<p>\u8d44\u6e90\u6587\u4ef6\u653e\u5728 <code>docs/assets/</code></p> <p>\u793a\u4f8b\u538b\u7f29\u5305\u4e0b\u8f7d</p> <p>\u4f7f\u7528\u65b9\u6cd5\uff1a\u628a\u4f60\u81ea\u5df1\u7684\u6587\u4ef6\u653e\u5230assets\u6587\u4ef6\u5939\uff0c\u4fee\u6539\u94fe\u63a5\u91cc\u7684\u6587\u4ef6\u540d\u5373\u53ef\u3002</p>"},{"location":"intro/","title":"LoTayu-Instrumentality-Project \u7f57\u5927\u4f51\u8865\u5b8c\u8ba1\u5212","text":"<p>\u672c\u9879\u76ee\u4e3a\u5171\u5efa\u9879\u76ee\uff0c\u9879\u76ee\u76ee\u524d\u5904\u4e8e\u5efa\u7ad9\u9636\u6bb5\u3002 \u8bf7\u4e00\u5b9a\u9605\u8bfbREADME\u6700\u540e\u7684\u201c\u6211\u60f3\u8bf4\u7684\u201d\u677f\u5757qwq</p>"},{"location":"intro/#_1","title":"\ud83d\udcd6 \u9879\u76ee\u7b80\u4ecb","text":"<ul> <li>LoTayu-Instrumentality-Project\uff08\u5373\u7f57\u5927\u4f51\u8865\u5b8c\u8ba1\u5212\uff09\uff0c\u662f\u4e00\u4e2a\u4e13\u6ce8\u4e8e\u7f57\u5927\u4f51\u97f3\u4e50\u4f5c\u54c1\uff08\u5c24\u5176\u662f\u5176\u201c\u7279\u5f02\u6b4c\u66f2\u201d\uff09\u7cfb\u7edf\u5316\u6536\u5f55\u3001\u6df1\u5ea6\u89e3\u6790\u4e0e\u8d44\u6e90\u6574\u7406\u7684\u5f00\u6e90\u9759\u6001Wiki\u9879\u76ee\u3002</li> <li>\u672c\u9879\u76ee\u5c24\u4ee5\u7f57\u5927\u4f51\u7279\u5f02\u97f3\u4e50\u4f5c\u54c1\u4e3a\u6838\u5fc3\uff0c\u805a\u7126\u5176\u4f5c\u54c1\u5728\u4e24\u5cb8\u4e09\u5730\u4e0d\u540c\u65f6\u4ee3\u3001\u4e0d\u540c\u5730\u533a\u7684\u7248\u672c\u5dee\u5f02\u3001\u6587\u672c\u6539\u52a8\u3001\u4f20\u64ad\u6d41\u53d8\u4e0e\u65f6\u4ee3\u9690\u55bb\uff0c\u91cd\u70b9\u6536\u5f55\u3001\u62c6\u89e3\u3001\u5206\u6790\u5177\u6709\u7279\u6b8a\u65f6\u4ee3\u5370\u8bb0\u4e0e\u5730\u57df\u5dee\u5f02\u5316\u7684\u300c\u7279\u5f02\u6b4c\u66f2\u300d\uff0c\u586b\u8865\u5176\u5728\u5899\u5185\u67d0\u4e9b\u4f5c\u54c1\u56e0\u6d89\u53ca\u654f\u611f\u8bdd\u9898\u800c\u65e0\u6cd5\u81ea\u7531\u6d41\u4f20\u7684\u6587\u5316\u7a7a\u767d\uff0c\u6784\u5efa\u4e00\u6240\u4f9b\u7f57\u5927\u4f51\u6b4c\u66f2\u7231\u597d\u8005\u4ee5\u53ca\u521a\u521a\u5165\u5751\u8fd9\u4e2a\u5708\u5b50\uff0c\u5bf9\u7f57\u5927\u4f51\u4e00\u4e9b\u6709\u7279\u6b8a\u542b\u4e49\u53ca\u65f6\u4ee3\u80cc\u666f\u7684\u6b4c\u66f2\u5c1a\u4e0d\u7406\u89e3\u7684\u840c\u65b0\u4eec\u67e5\u9605\u8d44\u6599\u7684\u8d44\u6599\u5e93\u3002\u6211\u4eec\u5f53\u7136\u8fd8\u4f1a\u4e0a\u4f20MV\uff0cMIDI\u7b49\u8d44\u6e90\uff0c\u65b9\u4fbf\u6211\u4eec\u7684\u5708\u53cb\u4eec\u8fdb\u884c\u4e8c\u521b\u3002</li> <li>\u672c\u9879\u76ee\u6700\u7ec8\u5f62\u6001\u4e3a\u8f7b\u91cf\u5316\u9759\u6001Wiki\u7f51\u7ad9\uff0c\u65e0\u540e\u7aef\u3001\u65e0\u6570\u636e\u5e93\u3001\u7a33\u5b9a\u53ef\u957f\u671f\u8fd0\u7ef4\uff0c\u517c\u5177\u5b66\u672f\u8003\u636e\u6027\u3001\u8d44\u6e90\u6536\u85cf\u6027\u4e0e\u79d1\u666e\u4f20\u64ad\u6027\u3002</li> </ul>"},{"location":"intro/#_2","title":"\ud83d\udcdd \u9879\u76ee\u7279\u8272","text":"<ul> <li>\u3010\u4e24\u5cb8\u4e09\u5730\u7279\u5f02\u6b4c\u66f2\u4e13\u9879\u89e3\u6790\u3011</li> <li> <p>\u4f17\u6240\u5468\u77e5\uff0c\u7f57\u5927\u4f51\u7684\u90e8\u5206\u4f5c\u54c1\u56e0\u5730\u57df\u5ba1\u6838\u3001\u65f6\u4ee3\u80cc\u666f\u4ea7\u751f\u4e86\u4e0d\u53ef\u907f\u514d\u7684\u6b4c\u8bcd\u5220\u51cf\u3001\u6587\u672c\u4fee\u6539\u3001\u66f2\u76ee\u66f4\u540d\u3001\u7248\u672c\u66ff\u6362\u3002\u6211\u4eec\u8ba1\u5212\u505a\u5bf9\u7167\u8003\u636e\uff0c\u68b3\u7406\u53f0\u6e7e\u539f\u7248\u3001\u9999\u6e2f\u6539\u7f16\u7248\u3001\u5927\u9646\u5f15\u8fdb\u7248\u7684\u5dee\u5f02\u7ec6\u8282\u3001\u6539\u52a8\u539f\u56e0\u4e0e\u4f20\u64ad\u5f71\u54cd\uff0c\u8fd8\u539f\u4f5c\u54c1\u5b8c\u6574\u521b\u4f5c\u539f\u8c8c\u3002</p> </li> <li> <p>\u3010\u5168\u66f2\u76ee\u7cfb\u7edf\u5316\u6536\u5f55\u3011</p> </li> <li> <p>\u6211\u4eec\u8ba1\u5212\u6309\u53d1\u884c\u5e74\u4ee3\u3001\u4e13\u8f91\u5e8f\u5217\u3001\u9898\u6750\u5206\u7c7b\u3001\u5730\u57df\u7248\u672c\u56db\u5927\u7ef4\u5ea6\uff0c\u89c4\u6574\u7f57\u5927\u4f51\u5168\u90e8\u6b63\u5f0f\u53d1\u884c\u66f2\u76ee\uff0c\u5efa\u7acb\u6807\u51c6\u5316\u66f2\u76ee\u7d22\u5f15\uff0c\u5f62\u6210\u5b8c\u6574\u4f5c\u54c1\u8c31\u7cfb\u3002</p> </li> <li> <p>\u3010\u591a\u7ef4\u4e50\u66f2\u8d44\u6e90\u6574\u5408\u3011</p> </li> <li> <p>\u6574\u7406\u6536\u5f55\u914d\u5957\u97f3\u4e50\u8d44\u6e90\uff0c\u5305\u542b\u81ea\u5236/\u5f00\u6e90MIDI\u5de5\u7a0b\u3001\u539f\u7248/\u4fee\u590d\u7248MV\u3001\u4e50\u8c31\u6252\u8c31\u8d44\u6599\u3001\u65e0\u635f\u97f3\u9891\u7d20\u6750\u3001\u66f2\u76ee\u4f34\u594f\u7b49\uff0c\u652f\u6301\u5728\u7ebf\u9884\u89c8\u4e0e\u5408\u89c4\u4e0b\u8f7d\uff0c\u9002\u914d\u97f3\u4e50\u5b66\u4e60\u3001\u4e8c\u6b21\u521b\u4f5c\u4e0e\u8d4f\u6790\u7814\u7a76\u573a\u666f\u3002</p> </li> <li> <p>\u3010\u8f7b\u91cf\u5316\u9759\u6001Wiki\u67b6\u6784\u3011</p> </li> <li>\u57fa\u4e8e\u9759\u6001\u7f51\u9875\u642d\u5efa\uff0c\u8bbf\u95ee\u7a33\u5b9a\u3001\u52a0\u8f7d\u5feb\u901f\u3001\u65e0\u9700\u670d\u52a1\u5668\u8fd0\u7ef4\uff0c\u652f\u6301\u5168\u6587\u68c0\u7d22\u3001\u76ee\u5f55\u5bfc\u822a\u3001\u5206\u7c7b\u5f52\u6863\uff0c\u9605\u8bfb\u4f53\u9a8c\u5ab2\u7f8e\u4e13\u4e1a\u77e5\u8bc6\u5e93\uff08\u771f\u7684\u4f1a\u5982\u6b64\u5417\ud83e\udd72\uff0c\u8c46\u5305\u4f60\u522b\u5439\u8fc7\u5934\u4e86\uff09</li> </ul>"},{"location":"intro/#_3","title":"\ud83d\udcc2 \u7f51\u7ad9\u5185\u5bb9\u67b6\u6784","text":"<p>\u9879\u76ee\u7ad9\u70b9\u91c7\u7528\u6a21\u5757\u5316Wiki\u7ed3\u6784\uff0c\u6574\u4f53\u89c4\u5212\u5982\u4e0b\uff1a 1. \u9879\u76ee\u4e3b\u9875\uff1a\u9879\u76ee\u5b97\u65e8\u3001\u66f4\u65b0\u65e5\u5fd7\u3001\u6574\u4f53\u89c4\u5212\u3001\u9002\u914d\u573a\u666f\u7b49\u8bf4\u660e 2. \u5168\u66f2\u76ee\u7d22\u5f15\u5e93\uff1a\u6309\u5e74\u4ee3/\u4e13\u8f91/\u9898\u6750/\u5730\u533a\u591a\u7ef4\u5ea6\u68c0\u7d22\u66f2\u76ee 3. \u7279\u5f02\u6b4c\u66f2\u4e13\u9898\uff08\u6838\u5fc3\u677f\u5757\uff09\uff1a\u7248\u672c\u5bf9\u7167\u3001\u6b4c\u8bcd\u5206\u6790\u3001\u65f6\u4ee3\u80cc\u666f\u3001\u521b\u4f5c\u52a8\u673a\u3001\u5730\u57df\u4f20\u64ad\u5dee\u5f02\u6df1\u5ea6\u89e3\u6790 4. \u97f3\u4e50\u8d44\u6e90\u5e93\uff1aMIDI\u3001MV\u3001\u4e50\u8c31\u3001\u4f34\u594f\u3001\u66f2\u8c31\u6587\u6863\u7b49\u8d44\u6e90\u5f52\u6863\u4e0e\u4e0b\u8f7d 5. \u8003\u636e\u9644\u5f55\uff1a\u53c2\u8003\u8d44\u6599\u3001\u6587\u732e\u6765\u6e90\u3001\u4e13\u8f91\u53d1\u884c\u8bb0\u5f55\u3001\u5a92\u4f53\u8bc4\u8ff0\u3001\u521b\u4f5c\u8bbf\u8c08\u5f52\u6863</p>"},{"location":"intro/#_4","title":"\u26a0\ufe0f \u9690\u79c1\u00b7\u7248\u6743\u00b7\u4e0e\u5408\u89c4\u58f0\u660e","text":"<ol> <li>\u672c\u9879\u76ee\u4e25\u683c\u4fdd\u62a4\u9690\u79c1\uff0c\u4e0d\u6536\u96c6\u3001\u516c\u793a\u4efb\u4f55\u4e0a\u4f20\u8005\u7cbe\u786e\u5730\u7406\u4f4d\u7f6e\u3001\u8054\u7cfb\u65b9\u5f0f\u3001\u4e2a\u4eba\u8eab\u4efd\u4fe1\u606f</li> <li>\u672c\u9879\u76ee\u6240\u6709\u6587\u5b57\u8003\u636e\u3001\u7248\u672c\u89e3\u6790\u3001\u80cc\u666f\u8bc4\u8ff0\u3001\u5bf9\u6bd4\u5206\u6790\u5185\u5bb9\u5747\u4e3a\u539f\u521b\u6574\u7406\uff0c\u9075\u5faa\u5f00\u6e90\u534f\u8bae\u5f00\u653e\u5206\u4eab\u3002</li> <li>\u9879\u76ee\u4e2d\u6536\u5f55\u7684\u81ea\u5236MIDI\u3001\u6252\u8c31\u8d44\u6599\u3001\u6574\u7406\u6587\u6848\u4e3a\u9879\u76ee\u539f\u521b\u8d44\u6e90\uff0c\u53ef\u81ea\u7531\u5b66\u4e60\u4f7f\u7528\u3002</li> <li>\u9879\u76ee\u4e0d\u79c1\u81ea\u5206\u53d1\u3001\u4e8c\u6b21\u4f20\u64ad\u53d7\u7248\u6743\u4fdd\u62a4\u7684\u539f\u7248\u5546\u7528\u97f3\u89c6\u9891\uff0c\u5546\u7528\u539f\u7248MV\u3001\u97f3\u9891\u4ec5\u505a\u5916\u94fe\u5f15\u7528\u3001\u79d1\u666e\u8d4f\u6790\uff0c\u4e0d\u63d0\u4f9b\u8fdd\u89c4\u4e0b\u8f7d\u4e0e\u5206\u53d1\uff0c\u4e25\u683c\u9075\u5faa\u8457\u4f5c\u6743\u76f8\u5173\u6cd5\u89c4\u3002</li> <li>\u672c\u9879\u76ee\u4e3a\u975e\u76c8\u5229\u5f00\u6e90\u6587\u5316\u6574\u7406\u9879\u76ee\uff0c\u4ec5\u7528\u4e8e\u97f3\u4e50\u6587\u5316\u7814\u7a76\u3001\u79d1\u666e\u5b66\u4e60\u4e0e\u4e2a\u4eba\u6536\u85cf\uff0c\u65e0\u4efb\u4f55\u5546\u4e1a\u7528\u9014\u3002</li> </ol>"},{"location":"intro/#_5","title":"\ud83e\udd14 \u5982\u4f55\u53c2\u4e0e\u8d21\u732e","text":"<ol> <li>Fork \u672c\u4ed3\u5e93</li> <li>\u521b\u5efa\u5206\u652f\u4fee\u6539\u5185\u5bb9</li> <li>\u63d0\u4ea4 Pull Request\uff08PR\uff09</li> <li>\u7b49\u5f85\u5ba1\u6838\u5408\u5e76</li> </ol>"},{"location":"intro/#_6","title":"\ud83d\udda5\ufe0f \u8d21\u732e\u8bf4\u660e","text":"<ol> <li>\u6b22\u8fce\u4efb\u4f55\u4eba\u901a\u8fc7 Fork + \u5206\u652f + PR \u7b49\u65b9\u5f0f\u53c2\u4e0e\u9879\u76ee\u8d21\u732e\uff0c\u5305\u62ec\u4e3a\u6211\u4eec\u63d0\u4f9b\u8d44\u6e90\uff08\u5982\u4e50\u66f2MIDI\uff0c\u6252\u8c31\u8d44\u6599\uff0c\u4f18\u79c0\u4e8c\u521b\uff0c\u66f2\u76ee\u6b4c\u8bcd\u53ca\u65f6\u4ee3\u80cc\u666f\u5206\u6790\uff09\uff0c\u7ef4\u62a4\u7f51\u7ad9\u53ca\u8d21\u732e\u4ee3\u7801\u7b49\u3002</li> <li>\u4ec5\u5728Issues\u7559\u8a00\u8ba8\u8bba\u4e0d\u4f1a\u81ea\u52a8\u8ba1\u5165\u4ee3\u7801\u8d21\u732e\u8005\uff0c\u63d0\u4ea4\u4ee3\u7801PR\u5e76\u5408\u5e76\u540e\uff0c\u4f1a\u81ea\u52a8\u51fa\u73b0\u5728\u9879\u76eeContributors\u5217\u8868\u3002</li> </ol>"},{"location":"intro/#_7","title":"\ud83d\udcec \u6c9f\u901a\u8ba8\u8bba","text":"<p>\u6211\u4eec\u6b22\u8fce\u4efb\u4f55\u53cb\u597d\u7684\u610f\u89c1\u3002\u82e5\u60a8\u6709\u60f3\u6cd5\u3001\u9700\u6c42\u6216\u5efa\u8bae\uff0c\u6216\u8005\u60f3\u6279\u5224\u6211\u4eec\u4e00\u4e9b\u4e0d\u59a5\u5f53\u7684\u505a\u6cd5\uff0c\u6b22\u8fce\u5728 Issues \u91cc\u65b0\u5efa\u8bdd\u9898\u3002</p>"},{"location":"intro/#_8","title":"\ud83d\udcdc \u5f00\u6e90\u534f\u8bae","text":"<p>\u672c\u9879\u76ee\u5185\u5bb9\u57fa\u4e8e CC BY-NC-SA 4.0 \u4ee5\u53ca MIT LICENSE \u975e\u5546\u7528\u5f00\u6e90\u534f\u8bae\u5f00\u653e\uff0c\u5141\u8bb8\u975e\u76c8\u5229\u5f15\u7528\u3001\u5b66\u4e60\u3001\u4e8c\u6b21\u6574\u7406\uff0c\u7981\u6b62\u5546\u4e1a\u8f6c\u8f7d\u5176\u5185\u5bb9\u4e0e\u8fdd\u89c4\u7be1\u6539\u3002\u8be6\u89c1 LICENSE \u6587\u4ef6</p>"},{"location":"intro/#_9","title":"\ud83d\udd04 \u9879\u76ee\u8fed\u4ee3\u8bf4\u660e","text":"<p>\u672c\u9879\u76ee\u957f\u671f\u6301\u7eed\u66f4\u65b0\uff0c\u9010\u6b65\u5b8c\u5584\u66f2\u76ee\u8865\u5168\u3001\u7248\u672c\u8003\u636e\u3001\u8d44\u6e90\u5f52\u6863\u4e0e\u5185\u5bb9\u4f18\u5316\uff0c\u81f4\u529b\u4e8e\u6253\u9020\u5168\u7f51\u6700\u5b8c\u6574\u3001\u6700\u7ec6\u81f4\u7684\u7f57\u5927\u4f51\u97f3\u4e50\u8003\u636e\u9759\u6001\u77e5\u8bc6\u5e93\uff0c\u8865\u5b8c\u56e0\u65f6\u4ee3\u56e0\u7d20\u9020\u6210\u7684\u4f5c\u54c1\u7ec6\u8282\u7a7a\u767d\u4ee5\u53ca\u4e0e\u5e74\u8f7b\u89c2\u4f17\u4e4b\u95f4\u7684\u9694\u9602\u3002</p>"},{"location":"intro/#_10","title":"\ud83d\ude14 \u6211\u4eec\u60f3\u5bf9\u4f60\u8bf4\u7684\u8bdd","text":"<p>\u9996\u5148\uff0c\u6211\u4eec\u771f\u5fc3\u5e0c\u671b\u4f60\u7684\u53c2\u4e0e\uff01 \u63a5\u4e0b\u6765\u662fQ&amp;A\uff1a</p> <ul> <li> <p>\u201c\u6211\u4eec\u201d\u662f\u8c01\uff1f</p> <ul> <li>\u6211\u4eec\u662f\u4e00\u7fa4\u7f57\u5927\u4f51\u6b4c\u66f2\u7231\u597d\u8005\uff0c\u5176\u4e2d\u4e00\u4f4d\u5bf9\u7f57\u5927\u4f51\u7684\u6b4c\u66f2\uff08\u51e0\u4e4e\u5168\u90e8\uff09\u6709\u6781\u5176\u6df1\u5ea6\u7684\u7406\u89e3\uff0c\u5e76\u4e14\u6781\u5ea6\u75f4\u8ff7\u4e8e\u7f57\u5927\u4f51\u7684\u6b4c\u66f2\uff1b\u800c\u53e6\u4e00\u4f4d\u5219\u662f\u4e00\u4f4d\u597d\u7684AI\u4f7f\u7528\u8005\uff08\u4e5f\u5c31\u662f\u6211\uff0c\u989d\u554a\uff09README\u7684\u5185\u5bb9\u5f88\u591a\u90fd\u662f\u7528AI\u751f\u6210\u7684\uff0c\u4e0d\u8fc7\u8fd9\u4e2a\u677f\u5757\u7684\u5168\u90e8\u5185\u5bb9\u90fd\u662f\u6211\u4eec\u5207\u5b9e\u60f3\u5bf9\u4f60\u8bf4\u7684\u3002</li> </ul> </li> <li> <p>\u6211\u4eec\u4e3a\u4ec0\u4e48\u60f3\u505a\u8fd9\u4e2a\u9879\u76ee\uff1f</p> <ul> <li> <p>\u6211\u66fe\u7ecf\u770b\u8fc7\u4e00\u4e2a\u6897\uff0c\u201c\u4e24\u5cb8\u4e09\u5730\u51d1\u4e0d\u51fa\u4f60\u7f57\u54e5\u7684\u5b8c\u6574\u6b4c\u5355...\u201d \u5176\u5b9e\u6211\u4eec\u90fd\u662f\u633a\u611f\u6027\u7684\u4eba\uff0c\u6211\u4eec\u53ea\u662f\u5f88\u5355\u7eaf\u7684\u89c9\u5f97\uff0c\u6240\u8c13\u6b4c\u66f2\uff0c\u5c31\u662f\u7528\u6765\u6292\u53d1\u613f\u6168\uff0c\u9488\u782d\u65f6\u5f0a\u7684\u3002\u201c \u5b50\u66f0\uff1a\u5c0f\u5b50\u4f55\u83ab\u5b66\u592b\u300a\u8bd7\u300b\uff1f\u300a\u8bd7\u300b\u53ef\u4ee5\u5174\uff0c\u53ef\u4ee5\u89c2\uff0c\u53ef\u4ee5\u7fa4\uff0c\u53ef\u4ee5\u6028\u3002\u201d\u2014\u2014\u2014\u300a\u8bba\u8bed\u300b\uff1b\u8fd9\u91cc\u7684\u201c\u8bd7\u201d\u5176\u5b9e\u5c31\u662f\u53e4\u4ee3\u7684\u4e50\u6b4c\uff0c\u800c\u6240\u8c13\u201c\u5174\u89c2\u7fa4\u6028\u201d\uff0c\u5219\u5206\u522b\u662f\u8d77\u5174\u610f\u5fd7\u3001\u89c2\u98ce\u4fd7\u4e4b\u5f97\u5931\u3001\u7fa4\u76f8\u5207\u78cb\u3001\u8bbd\u523a\u65f6\u653f\u4e4b\u610f\u3002</p> <p>\u7f57\u5927\u4f51\u7684\u6b4c\u65e0\u7591\u662f\u5174\u89c2\u7fa4\u6028\u7684\uff0c\u751a\u81f3\u53ef\u4ee5\u8bf4\uff0c\u4ed6\u90a3\u6216\u5b09\u7b11\u6012\u9a82\uff0c\u6216\u542b\u6c99\u5c04\u5f71\uff0c\u6216\u6fc0\u4eba\u594b\u8fdb\uff0c\u6216\u7ef5\u8f6c\u60a0\u957f\u7684\u6f14\u5531\u98ce\u683c\uff0c\u4e5f\u6b63\u662f\u5f88\u591a\u7c89\u4e1d\uff08\u5305\u62ec\u6211\uff09\u80fd\u5982\u6b64\u559c\u7231\u4ed6\u7684\u539f\u56e0\u3002\u5728\u7f57\u5927\u4f51\u51fa\u73b0\u4e4b\u524d\uff0c\u534e\u8bed\u6d41\u884c\u97f3\u4e50\uff08\u5c24\u5176\u662f70-80\u5e74\u4ee3\u521d\uff09\u5927\u90e8\u5206\u662f\u98ce\u82b1\u96ea\u6708\u7684\u5c0f\u60c5\u6b4c\u3001\u6821\u56ed\u6c11\u8c23\u6216\u751c\u7f8e\u6e29\u5a49\u7684\u6d41\u884c\u66f2\uff08\u5982\u9093\u4e3d\u541b\u5f0f\u7684\u67d4\u60c5\uff09\u3002\u800c\u7f57\u5927\u4f51\u4e4b\u6240\u4ee5\u80fd\u88ab\u8a89\u4e3a\u201c\u534e\u8bed\u4e50\u575b\u7684\u6559\u7236\u201d\uff0c\u6b63\u662f\u56e0\u4e3a\u4ed6\u8d4b\u4e88\u4e86\u6d41\u884c\u4e50\u66f2\u601d\u60f3\u7684\u6df1\u5ea6\u3002</p> <p>\u7f57\u5927\u4f51\u7b2c\u4e00\u6b21\u8bc1\u660e\u4e86\uff0c\u6d41\u884c\u6b4c\u66f2\u4e5f\u80fd\u63a2\u8ba8\u793e\u4f1a\u8f6c\u578b\u3001\u653f\u6cbb\u53d8\u5e7b\u3001\u90fd\u5e02\u5f02\u5316\u3001\u73af\u5883\u7834\u574f\u3001\u6559\u80b2\u4f53\u5236\u4ee5\u53ca\u4eba\u4eec\u5728\u65f6\u4ee3\u4e0e\u653f\u6cbb\u6e38\u620f\u4e0b\u7684\u8ff7\u832b\uff1b\u4ed6\u65e9\u671f\u7684\u9ed1\u8863\u3001\u58a8\u955c\u3001\u5377\u53d1\u7684\u201c\u7279\u5f02\u201d\u5f62\u8c61\uff0c\u642d\u914d\u5486\u54ee\u5f0f\u7684\u6447\u6eda\u5531\u8154\uff0c\u5c55\u73b0\u51fa\u4e00\u79cd\u5bf9\u73b0\u5b9e\u7edd\u4e0d\u59a5\u534f\u7684\u6279\u5224\u59ff\u6001\uff0c\u6ee1\u8db3\u4e86\u6570\u4ee3\u5e74\u8f7b\u4eba\u5bf9\u201c\u72ec\u7acb\u601d\u8003\u201d\u548c\u201c\u53db\u9006\u7cbe\u795e\u201d\u7684\u5bc4\u6258\uff08\u6211\u60f3\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u6211\u4eec\u4f1a\u5982\u6b64\u559c\u7231\u4ed6\u5427\uff09\u3002\u800c\u5f53\u4ed6\u653e\u4e0b\u6279\u5224\u7684\u5229\u5668\u65f6\uff0c\u4ed6\u53c8\u80fd\u5e26\u7ed9\u6211\u4eec\u91ce\u767e\u5408\u4e5f\u6709\u6625\u5929\u4e00\u822c\u7684\u6e29\u67d4\u3002</p> <p>\u53ef\u662f\uff0c\u4e0d\u662f\u6240\u6709\u4eba\u90fd\u5e0c\u671b\u542c\u5230\u4ed6\u7684\u6b4c\uff0c\u4ee5\u81f3\u4e8e\u4ed6\u4eec\u4e5f\u4e0d\u5e0c\u671b\u6211\u4eec\u542c\u89c1\uff0c\u7406\u89e3\uff0c\u4f20\u5531\u4ed6\u7684\u67d0\u4e9b\u6b4c\u66f2\u3002</p> <p>\u300a\u98de\u8f66\u300b\u300a\u9996\u90fd\u300b\u300a\u7687\u540e\u5927\u9053\u4e1c\u300b\u8fd9\u201c\u4e09\u5927\u4ef6\u201d\u81ea\u4e0d\u5fc5\u8bf4\uff1b\u300a\u4f8f\u5112\u4e4b\u6b4c\u300b\u300a\u4eac\u57ce\u591c\u300b\u7b49\u4e5f\u540c\u6837\u672a\u80fd\u5e78\u514d\u4e8e\u96be\u3002\u8fd9\u4e9b\u6b4c\u66f2\u90fd\u662f\u5bcc\u6709\u6df1\u610f\u4e14\u5177\u6709\u6781\u9ad8\u7684\u65f6\u4ee3\u4ef7\u503c\u7684\uff0c\u53ef\u662f\uff0c\u6709\u65f6\u5019\u6211\u4e5f\u4e0d\u77e5\u9053\u8be5\u8bf4\u4ec0\u4e48\uff0c\u6211\u4e5f\u4e0d\u60f3\u8bf4\u4ec0\u4e48\u4e86\uff0c\u201c\u6211\u60f3\u8981\u8bf4\u7684\u524d\u4eba\u4eec\u90fd\u8bf4\u8fc7\u4e86\u201d\u3002\u603b\u4e4b\uff0c\u5728\u653f\u6cbb\u8fd9\u64cd\u86cb\u7684\u6e38\u620f\u4e0b\uff0c\u5f88\u591a\u4eba\u5f88\u96be\u5728\u9ad8\u5899\u4e4b\u5185\u53bb\u7406\u89e3\u8fd9\u4e9b\u6b4c\u66f2\u7684\u6df1\u610f\u3002\u6cb9\u7ba1\uff08youtube\uff09\u4e0a\u81ea\u7136\u6709\u8bb2\u89e3\u8fd9\u4e9b\u6b4c\u66f2\u7684\u89c6\u9891\uff0c\u53ef\u6211\u4eec\u89c9\u5f97\u5f88\u591a\u89c6\u9891\u5206\u6790\u5f97\u6709\u70b9\u201c\u4e0d\u591f\u683c\u201d\uff0c\u6211\u4eec\u53ef\u4ee5\u8ba9\u5b83\u4eec\u53d8\u5f97\u66f4\u597d\u3002</p> <p>\u5176\u5b9e\u4e5f\u7b97\u6211\u4eec\u53db\u9006\u5427\uff0c\u53cd\u6b63\u6211\u662f\u770b\u4e0d\u60ef\u67d0\u7fa4\u201c\u516c\u4ec6\u201d\u4eec\u5634\u8fb9\u6302\u7740\u81ea\u5df1\u7684\u5149\u8f89\u4f1f\u4e1a\u5374\u4e0d\u8bb8\u4eba\u6c11\u4e86\u89e3\u90a3\u4e9b\u5386\u53f2\uff0c\u4ee5\u81f3\u4e8e\u8981\u628a\u6587\u827a\u4f5c\u54c1\u62b9\u6740\u7684\u4e11\u6001\uff0c\u53bb\u4f60\u5988\u7684\u3002</p> <p>\u6240\u4ee5\u6211\u4eec\u60f3\u505a\u4e00\u4e2a\u9879\u76ee\uff0c\u53eb\u505a LoTayu-Instrumentality-Project \u7f57\u5927\u4f51\u8865\u5b8c\u8ba1\u5212\u3002\u9879\u76ee\u540d\u7684\u7075\u611f\u6765\u6e90\u4e8e\u300a\u65b0\u4e16\u7eaa\u798f\u97f3\u6218\u58eb\u300b\uff08EVA\uff09\u4e2d\u7684\u201c\u4eba\u7c7b\u8865\u5b8c\u8ba1\u5212\u201d\u3002\u6211\u4eec\u5e0c\u671b\u8fd9\u4e2a\u9879\u76ee\u80fd\u4e3a\u90a3\u4e9b\u5c1a\u672a\u5165\u5751\u6216\u5165\u5751\u6ca1\u591a\u4e45\u7684\u201c\u5c0f\u7f57\u201d\u4eec\u8bb2\u89e3\u6e05\u695a\uff0c\u90a3\u4e9b\u53ef\u80fd\u662f\u4f60\u4eec\u5165\u5751\u76f4\u63a5\u9a71\u52a8\u7684\u201c\u7279\u5f02\u6b4c\u66f2\u201d\uff0c\u5b83\u4eec\u88ab\u521b\u4f5c\u7684\u65f6\u4ee3\u80cc\u666f\u662f\u4ec0\u4e48\uff0c\u5b83\u4eec\u7684\u6b4c\u8bcd\u6709\u4ec0\u4e48\u6df1\u610f\uff0c\u4ee5\u53ca\u81ea\u7136\u800c\u7136\u7684\uff0c\u5b83\u4eec\u4e3a\u4ec0\u4e48\u4f1a\u88ab\u5c01\u7981\u3002\u6240\u4ee5\u4e0e\u6b64\u540c\u65f6\uff0c\u4f60\u53ef\u80fd\u8fd8\u80fd\u501f\u6b64\u673a\u4f1a\u6df1\u5165\u4e86\u89e3\u90a3\u6bb5\u98ce\u4e91\u53d8\u5e7b\u7684\u5c81\u6708\uff0c\u4e86\u89e3\u90a3\u6bb5\u4ee4\u4eba\u550f\u5618\u5374\u88ab\u5f53\u5c40\u4e0d\u5e0c\u671b\u4f60\u4e86\u89e3\u5386\u53f2\u3002\u5728\u6211\u770b\u6765\u8fd9\u4e5f\u662f\u6587\u827a\u4f5c\u54c1\u4e00\u4e2a\u5f88\u91cd\u8981\u7684\u4f5c\u7528---\u7acb\u53f2\u4e3a\u9274\uff0c\u7ee7\u5f80\u4e8b\uff0c\u793a\u4e16\u4eba\uff0c\u53cd\u4e86\u90a3\u300a1984\u300b\u822c\u7684\u4e4c\u6258\u90a6\u3002</p> <p>\u5f53\u7136\uff0c\u6211\u4eec\u80af\u5b9a\u4e0d\u5e0c\u671b\u4f60\u4ec5\u4ec5\u662f\u56e0\u4e3a\u201c\u7279\u5f02\u6b4c\u66f2\u201d\u800c\u5165\u5751\u7684\uff0c\u4e5f\u4e0d\u5e0c\u671b\u6211\u4eec\u9879\u76ee\u53d8\u6210\u4e00\u4e2a\u7ed9\u952e\u653f\u5c0f\u9b3c\u6447\u65d7\u5450\u558a\u7684\u81ed\u6c34\u6c9f\u3002\u6211\u4eec\u540c\u6837\u4e5f\u4f1a\u6536\u5f55\uff0c\u5206\u6790\uff0c\u89e3\u8bfb\u7f57\u5927\u4f51\u7684\u90a3\u4e9b\u201c\u4e0d\u7279\u5f02\u6b4c\u66f2\u201d\u3002\u540c\u65f6\u6211\u4eec\u4e5f\u4f1a\u6536\u96c6\u5e76\u4e0a\u4f20\u6709\u5173\u6b4c\u66f2\u7684\u5468\u8fb9\u8d44\u6e90\uff0c\u6bd4\u5982\u5404\u7248\u672cMV\uff0c\u4e50\u66f2MIDI\uff0c\u5c01\u9762\u6b4c\u8bcd\u7b49\u5185\u5bb9\uff0c\u8fd8\u4f1a\u6536\u5f55\u4e00\u4e9b\u8da3\u4e8b\u548c\u540d\u6897\uff08\u4eca\u5929\u62fc\u4e86\ud83d\ude0e\uff09\uff0c\u6700\u7ec8\u6784\u5efa\u4e00\u4e2a\u670d\u52a1\u4e8e\u5168\u4f53\u7f57\u5927\u4f51\u7c89\u4e1d\u7684WIKI\u7f51\u7ad9\u3002</p> <p>\u6211\u4eec\u4e0d\u4ee5\u76c8\u5229\u4e3a\u76ee\u7684\u5e76\u4e14\u613f\u610f\u5f00\u6e90\u6211\u4eec\u7684\u9879\u76ee\uff0c\u7eaf\u7cb9\u4e3a\u7231\u53d1\u7535\u3002</p> <p>\u5728\u6b64\u6211\u4eec\u5411\u534e\u8bed\u4e50\u575b\u7684\u6559\u7236\u7f57\u5927\u4f51\u5148\u751f\u81f4\u4ee5\u6700\u5d07\u9ad8\u7684\u656c\u610f\uff0c\u540c\u65f6\u6211\u4eec\u4f1a\u6ce8\u610f\u7248\u6743\u95ee\u9898\uff0c\u4e0d\u4f1a\u4e0a\u4f20\u5b8c\u6574\u6b4c\u8bcd\u7b49\u6d89\u53ca\u7248\u6743\u7684\u95ee\u9898\uff0c\u800c\u7528\u5d4c\u5165\u5916\u90e8\u94fe\u63a5\u6216\u5f15\u7528\u56fe\u7247\u4ee3\u66ff\u3002</p> <p>\u6240\u4ee5\u5c31\u662f\u8fd9\u6837\u4e86\uff0c\u5e0c\u671b\u80fd\u5f97\u5230\u4f60\u4eec\u652f\u6301\u5427\uff5e\u6240\u6709\u70ed\u7231\u7f57\u5927\u4f51\u7684\u670b\u53cb\u4eec\u3002</p> <p>\u7231\u4f60\u4eec\u55b5\u3002</p> </li> </ul> </li> </ul>"},{"location":"songs/","title":"\u66f2\u76ee\u767e\u79d1","text":""},{"location":"stories/","title":"\u8001\u7f57\u5f80\u4e8b","text":""},{"location":"thanks/","title":"\u9e23\u8c22","text":""}]}